{
  "name": "accountability",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "import:data": "npx tsx scripts/import-excel.ts",
    "import:aggregates": "npx tsx scripts/regenerate-aggregates.ts",
    "db:reload": "curl -s -X POST http://localhost:3000/api/internal/reload-public-db -H 'Authorization: Bearer ${INTERNAL_ADMIN_TOKEN:-change-me}' | node -e \"process.stdin.resume();process.stdin.on('data',d=>console.log(JSON.parse(d)))\"",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "better-sqlite3": "^12.10.0",
    "leaflet": "^1.9.4",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-leaflet": "^4.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  }
}
